# Copy this file to .env (same folder) and fill in what you use. .env is never uploaded to git.

# --- The AI judge that picks the best moments (choose ONE; both work).
# OpenRouter: sign up at https://openrouter.ai, add $5 of credit, create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# (optional) Quanzil, a cheaper relay for the same Gemini model. Leave empty if you don't have one.
QUANZIL_API_KEY=

# (optional) stop spending once the AI has cost this many dollars in total. Empty = no cap.
CLIPPER_BUDGET_USD=5

# --- (optional) a fixed web address for the studio through Vercel. See README, "Use it from your phone".
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# The address becomes https://<VERCEL_ALIAS>.vercel.app (letters, digits and dashes; must be free on Vercel)
VERCEL_ALIAS=
